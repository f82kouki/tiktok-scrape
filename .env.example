# 任意のプロキシ（住宅IPプロキシ推奨。データセンターIPはTikTokに弾かれやすい）
# 例: http://user:pass@proxy.example.com:8080
HTTP_PROXY=

# 1リクエストごとの待機秒数（min, max）
# 軽め: 4〜8（小規模テスト用）
# 推奨: 10〜30（scale ラン / bot検出リスク低減）
REQUEST_INTERVAL_MIN=10.0
REQUEST_INTERVAL_MAX=30.0

# 実行時にデバッグログを表示するか
DEBUG=true

# 非ヘッドレスで起動（デバッグ時 / make login 時のみ false）
HEADLESS=true

# 手動ログイン後の cookie を保存する永続プロファイルディレクトリ
# 設定すれば make login → cookie 保存 → 以降のリクエストで自動利用される
TIKTOK_USER_DATA_DIR=./.tiktok_profile

# ---- TikTok Shop 店舗スクレイパー PoC ----
# 発見の主起点（Japan 専用マーケット入口。別ホストで robots catch-all Disallow なし）
TIKTOK_SHOP_ENTRY_URL=https://shop.tiktok.com/jp
# 予備: 構造ダンプ/小ロットで直接投入する店舗URL（カンマ区切り）
TIKTOK_SHOP_SEED_URLS=
# /tag/ 経由の補助発見に使うカテゴリ語（カンマ区切り、robots Allow: /tag）
TIKTOK_SHOP_CATEGORIES=コスメ,美容,食品
# 小ロット取得の上限（PoC は小さく）
TIKTOK_SHOP_MAX=20
# 注: 発見系は BAN リスクが高いため REQUEST_INTERVAL_MIN/MAX は 10〜30 秒を推奨
