# 任意のプロキシ（住宅IPプロキシ推奨。データセンターIPはTikTokに弾かれやすい）
# 例: http://user:pass@proxy.example.com:8080
HTTP_PROXY=

# 1リクエストごとの待機秒数（min, max）
# 軽め: 4〜8（小規模テスト用）
# 推奨: 10〜30（scale ラン / bot検出リスク低減）
REQUEST_INTERVAL_MIN=10.0
REQUEST_INTERVAL_MAX=30.0

# 実行時にデバッグログを表示するか
DEBUG=true

# 非ヘッドレスで起動（デバッグ時 / make login 時のみ false）
HEADLESS=true

# 手動ログイン後の cookie を保存する永続プロファイルディレクトリ
# 設定すれば make login → cookie 保存 → 以降のリクエストで自動利用される
TIKTOK_USER_DATA_DIR=./.tiktok_profile

# ---- TikTok Shop 店舗スクレイパー PoC（shop.tiktok.com 経路）----
# 発見の入口（Japan マーケット。ここからカテゴリ /jp/c/{slug}/{id} を発見）
TIKTOK_SHOP_ENTRY_URL=https://shop.tiktok.com/jp
# 任意: 巡回するカテゴリURLを明示指定（カンマ区切り）。設定すると入口発見をスキップ
#   例: https://shop.tiktok.com/jp/c/beauty-personal-care/601450,https://shop.tiktok.com/jp/c/food-beverages/700437
TIKTOK_SHOP_CATEGORY_URLS=
# 予備: 直接投入する PDP または 店舗URL（カンマ区切り）。構造ダンプ/小ロットで使用
#   PDP  : https://shop.tiktok.com/jp/pdp/<product_id>
#   店舗 : https://shop.tiktok.com/jp/store/<slug>/<seller_id>
TIKTOK_SHOP_SEED_URLS=
# 小ロット取得の上限（PoC は小さく）
TIKTOK_SHOP_MAX=20
# 注: 発見系は BAN リスクが高いため REQUEST_INTERVAL_MIN/MAX は 10〜30 秒を推奨
